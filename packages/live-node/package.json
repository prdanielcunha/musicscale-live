{
  "name": "@millionsnest/live-node",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "package:sea": "npm run build && node scripts/build-sea.mjs",
    "test:reliability": "vitest run --config vitest.config.ts test/idempotencyStore.test.ts test/runtimeStateStore.test.ts test/liveEventLogStore.test.ts test/pairingStore.test.ts test/providerConfigStore.test.ts test/secretProtector.test.ts"
  },
  "dependencies": {
    "@millionsnest/live-domain": "0.0.1",
    "@millionsnest/live-adapter-holyrics": "0.0.1",
    "qrcode": "^1.5.4",
    "@millionsnest/live-adapter-resolume": "0.0.1",
    "@millionsnest/live-adapter-propresenter": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10",
    "@types/qrcode": "^1.5.5",
    "postject": "^1.0.0-alpha.6"
  }
}
